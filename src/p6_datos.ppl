  "#Agua líquida a 20 °C (aprox.)"," densidad  998.2  kg/m³"," viscosidad  1.002  cP"," calor específico  4182  J/(kg.K)"};
  UiVer("Constantes",lLin);
END;

// ---------- Masa molar ----------

QmSimbolos()
BEGIN
  RETURN {"H","He","Li","Be","B","C","N","O","F","Ne","Na","Mg","Al","Si","P","S","Cl","Ar","K","Ca","Sc","Ti","V","Cr","Mn","Fe","Co","Ni","Cu","Zn","Ga","Ge","As","Se","Br","Kr","Rb","Sr","Y","Zr","Nb","Mo","Tc","Ru","Rh","Pd","Ag","Cd","In","Sn","Sb","Te","I","Xe","Cs","Ba","La","Ce","Pr","Nd","Pm","Sm","Eu","Gd","Tb","Dy","Ho","Er","Tm","Yb","Lu","Hf","Ta","W","Re","Os","Ir","Pt","Au","Hg","Tl","Pb","Bi","Po","At","Rn","Fr","Ra","Ac","Th","Pa","U","Np","Pu","Am","Cm","Bk","Cf","Es","Fm","Md","No","Lr","D","T"};
END;

QmMasas()
BEGIN
  RETURN {1.008,4.0026,6.94,9.0122,10.81,12.011,14.007,15.999,18.998,20.180,22.990,24.305,26.982,28.085,30.974,32.06,35.45,39.948,39.098,40.078,44.956,47.867,50.942,51.996,54.938,55.845,58.933,58.693,63.546,65.38,69.723,72.630,74.922,78.971,79.904,83.798,85.468,87.62,88.906,91.224,92.906,95.95,98,101.07,102.906,106.42,107.868,112.414,114.818,118.710,121.760,127.60,126.904,131.293,132.905,137.327,138.905,140.116,140.908,144.242,145,150.36,151.964,157.25,158.925,162.500,164.930,167.259,168.934,173.045,174.967,178.486,180.948,183.84,186.207,190.23,192.217,195.084,196.967,200.592,204.38,207.2,208.980,209,210,222,223,226,227,232.038,231.036,238.029,237,244,243,247,247,251,252,257,258,259,262,2.0141,3.0160};
END;

// Analiza una formula quimica. Devuelve {indices de elementos, cantidades}.
// Si hay un error deja gBad en 1 y el motivo en gErr.
QmParse(sFor)
BEGIN
  LOCAL lPartes,nPar,sPar,lCod,nLen,nPos,nCod,nFac;
  LOCAL sNum,lPila,sLow,sSim,nIdx,lSim,lEle,lCnt;
  LOCAL nMul,nEle,nYa,nIni,nNum,nTope;
  gBad:=0;
  gErr:="";
  lSim:=QmSimbolos();
  lEle:={};
  lCnt:={};
  // los hidratos se separan con * (por ejemplo CuSO4*5H2O)
  lPartes:=UiPartir(sFor,"*");
  FOR nPar FROM 1 TO SIZE(lPartes) DO
    sPar:=lPartes(nPar);
    lCod:={};
    IF sPar<>"" THEN lCod:=ASC(sPar); END;
    nLen:=SIZE(lCod);
    // coeficiente inicial de la parte (el 5 de 5H2O)
    nIni:=1;
    nFac:=1;
    sNum:="";
    nYa:=0;
    WHILE nIni<=nLen AND nYa==0 DO
      nCod:=lCod(nIni);
      IF nCod>=48 AND nCod<=57 THEN
        sNum:=sNum+CHAR(nCod);
        nIni:=nIni+1;
      ELSE
        IF nCod==32 THEN
          nIni:=nIni+1;
        ELSE
          nYa:=1;
        END;
      END;
    END;
    IF sNum<>"" THEN nFac:=EXPR(sNum); END;
    // se recorre de derecha a izquierda
    lPila:={nFac};
    sNum:="";
    sLow:="";
    nPos:=nLen;
    WHILE nPos>=nIni DO
      nCod:=lCod(nPos);
      nTope:=lPila(SIZE(lPila));
      nNum:=1;
      IF sNum<>"" THEN nNum:=EXPR(sNum); END;
      IF nCod>=48 AND nCod<=57 THEN
        sNum:=CHAR(nCod)+sNum;
      END;
      IF nCod==41 OR nCod==93 THEN
        lPila:=CONCAT(lPila,{nTope*nNum});
        sNum:="";
      END;
      IF nCod==40 OR nCod==91 THEN
        IF SIZE(lPila)>1 THEN
          lPila:=UiSinUlt(lPila);
        ELSE
          gBad:=1;
          gErr:="paréntesis sin cerrar";
        END;
        sNum:="";
      END;
      IF nCod>=97 AND nCod<=122 THEN
        sLow:=CHAR(nCod)+sLow;
      END;
      IF nCod>=65 AND nCod<=90 THEN
        sSim:=CHAR(nCod)+sLow;
        nEle:=UiPos(lSim,sSim);
        IF nEle==0 THEN
          gBad:=1;
          gErr:="no conozco el elemento "+sSim;
        ELSE
          nMul:=nNum*nTope;
          nIdx:=UiPos(lEle,nEle);
          IF nIdx==0 THEN
            lEle:=CONCAT({nEle},lEle);
            lCnt:=CONCAT({nMul},lCnt);
          ELSE
            lCnt(nIdx):=lCnt(nIdx)+nMul;
          END;
        END;
        sNum:="";
        sLow:="";
      END;
      nPos:=nPos-1;
    END;
    IF SIZE(lPila)>1 THEN
      gBad:=1;
      gErr:="paréntesis sin abrir";
    END;
    IF sLow<>"" THEN
      gBad:=1;
      gErr:="los símbolos empiezan con mayúscula";
    END;
  END;
  IF SIZE(lEle)==0 AND gBad==0 THEN
    gBad:=1;
    gErr:="no encontré elementos";
  END;
  RETURN {lEle,lCnt};
END;

MdMasaMolar()
BEGIN
  LOCAL lDat,lRes,lEle,lCnt,lSim,lMas,nTot,nIdx;
  LOCAL lLin,nFin,sFor,nApo,lGr,nMol,nBot;
  nFin:=0;
  sFor:="Ca(OH)2";
  lSim:=QmSimbolos();
  lMas:=QmMasas();
  REPEAT
    lDat:=UiPedir("Masa molar",{"Fórmula: "},{"Respetar mayúsculas: Ca(OH)2, H2SO4, CuSO4*5H2O, D2O"},{sFor},1);
    IF SIZE(lDat)==0 THEN
      nFin:=1;
    ELSE
      sFor:=lDat(1);
      lRes:=QmParse(sFor);
      IF gBad THEN
        UiAviso("Fórmula no válida: "+gErr);
        gBad:=0;
      ELSE
        lEle:=lRes(1);
        lCnt:=lRes(2);
        nTot:=0;
        FOR nIdx FROM 1 TO SIZE(lEle) DO
          nTot:=nTot+lCnt(nIdx)*lMas(lEle(nIdx));
        END;
        lLin:={"#Masa molar de "+sFor,"!"+UiNum(nTot,8)+"  g/mol","#Composición:  elemento x átomos,  gramos por mol,  % en masa"};
        FOR nIdx FROM 1 TO SIZE(lEle) DO
          nApo:=lCnt(nIdx)*lMas(lEle(nIdx));
          lLin:=CONCAT(lLin,{" "+lSim(lEle(nIdx))+" x "+UiNum(lCnt(nIdx),6)+"     "+UiNum(nApo,7)+" g     "+UiNum(100*nApo/nTot,4)+" %"});
        END;
        nBot:=1;
        WHILE nBot==1 DO
          nBot:=UiTexto("Masa molar",lLin,{"g y mol","",""});
          IF nBot==1 THEN
            lGr:=UiPedir("Gramos y moles",{"Masa en gramos = ","Moles = "},{"Completar uno y dejar el otro en 0","Completar uno y dejar el otro en 0"},{0,0},0);
            IF SIZE(lGr)>0 THEN
              IF lGr(1)<>0 THEN
                nMol:=lGr(1)/nTot;
                UiVer("Gramos y moles",{"#"+sFor+"   "+UiNum(nTot,8)+" g/mol","#Masa"," "+UiNum(lGr(1),9)+"  g","#Moles","!"+UiNum(nMol,9)+"  mol","#Moléculas (o unidades fórmula)"," "+UiNum(nMol*6.02214076*10^23,7)});
              ELSE
                UiVer("Gramos y moles",{"#"+sFor+"   "+UiNum(nTot,8)+" g/mol","#Moles"," "+UiNum(lGr(2),9)+"  mol","#Masa","!"+UiNum(lGr(2)*nTot,9)+"  g","#Moléculas (o unidades fórmula)"," "+UiNum(lGr(2)*6.02214076*10^23,7)});
              END;
            END;
          END;
        END;
      END;
    END;
  UNTIL nFin;
END;
