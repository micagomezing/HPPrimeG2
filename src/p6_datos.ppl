
// ---------- Unidades ----------

UnCats()
BEGIN
  RETURN {"Longitud","Área","Volumen","Masa","Tiempo","Temperatura","Presión","Energía","Potencia","Fuerza","Viscosidad dinámica","Viscosidad cinemática, difusividad","Densidad","Velocidad","Caudal volumétrico","Calor específico","Conductividad térmica","Coef. de transferencia de calor","Energía molar","Cantidad de sustancia","Actividad radiactiva","Dosis absorbida","Dosis equivalente","Exposición","Ángulo"};
END;

// Devuelve {nombres, factores}. El factor pasa 1 unidad a la unidad base.
UnDatos(nCat)
BEGIN
  IF nCat==1 THEN RETURN {{"m","cm","mm","km","micrómetro","nm","angstrom","pulgada (in)","pie (ft)","yarda","milla"},{1,0.01,0.001,1000,0.000001,0.000000001,0.0000000001,0.0254,0.3048,0.9144,1609.344}}; END;
  IF nCat==2 THEN RETURN {{"m²","cm²","mm²","km²","hectárea","in²","ft²","barn"},{1,0.0001,0.000001,1000000,10000,0.00064516,0.09290304,10^(-28)}}; END;
  IF nCat==3 THEN RETURN {{"m³","litro","mL (cm³)","ft³","in³","galón (US)","barril de petróleo"},{1,0.001,0.000001,0.028316846592,0.000016387064,0.003785411784,0.158987294928}}; END;
  IF nCat==4 THEN RETURN {{"kg","g","mg","tonelada","libra (lb)","onza (oz)","u (uma)"},{1,0.001,0.000001,1000,0.45359237,0.028349523125,1.66053906892*10^(-27)}}; END;
  IF nCat==5 THEN RETURN {{"s","min","h","día","año (365,25 d)","ms","microsegundo"},{1,60,3600,86400,31557600,0.001,0.000001}}; END;
  IF nCat==7 THEN RETURN {{"Pa","kPa","MPa","bar","atm","mmHg (torr)","psi","kgf/cm²","m de agua","in de Hg"},{1,1000,1000000,100000,101325,133.322368421,6894.75729317,98066.5,9806.65,3386.38815789}}; END;
  IF nCat==8 THEN RETURN {{"J","kJ","cal (termoquímica)","kcal","BTU","kWh","eV","MeV","erg","L.atm","ft.lbf"},{1,1000,4.184,4184,1055.05585262,3600000,1.602176634*10^(-19),1.602176634*10^(-13),0.0000001,101.325,1.3558179483314}}; END;
  IF nCat==9 THEN RETURN {{"W","kW","MW","hp","CV","BTU/h","kcal/h"},{1,1000,1000000,745.699871582,735.49875,0.29307107017,1.16222222222}}; END;
  IF nCat==10 THEN RETURN {{"N","kN","kgf","lbf","dina"},{1,1000,9.80665,4.4482216152605,0.00001}}; END;
  IF nCat==11 THEN RETURN {{"Pa.s","cP (mPa.s)","poise","lb/(ft.s)","lb/(ft.h)"},{1,0.001,0.1,1.48816394357,0.000413378873214}}; END;
  IF nCat==12 THEN RETURN {{"m²/s","cm²/s (stokes)","cSt (mm²/s)","ft²/s","ft²/h"},{1,0.0001,0.000001,0.09290304,0.0000258064}}; END;
  IF nCat==13 THEN RETURN {{"kg/m³","g/cm³","kg/L","lb/ft³","lb/galón (US)"},{1,1000,1000,16.018463374,119.826427317}}; END;
  IF nCat==14 THEN RETURN {{"m/s","km/h","ft/s","milla/h","nudo"},{1,0.277777777778,0.3048,0.44704,0.514444444444}}; END;
  IF nCat==15 THEN RETURN {{"m³/s","m³/h","L/s","L/min","galón/min (US)","ft³/s","ft³/min"},{1,0.000277777777778,0.001,0.0000166666666667,0.0000630901964,0.028316846592,0.0004719474432}}; END;
  IF nCat==16 THEN RETURN {{"J/(kg.K)","kJ/(kg.K)","cal/(g.°C)","kcal/(kg.°C)","BTU/(lb.°F)"},{1,1000,4184,4184,4186.8}}; END;
  IF nCat==17 THEN RETURN {{"W/(m.K)","kcal/(h.m.°C)","cal/(s.cm.°C)","BTU/(h.ft.°F)"},{1,1.16222222222,418.4,1.73073466637}}; END;
  IF nCat==18 THEN RETURN {{"W/(m².K)","kcal/(h.m².°C)","BTU/(h.ft².°F)"},{1,1.16222222222,5.67826334111}}; END;
  IF nCat==19 THEN RETURN {{"J/mol","kJ/mol","cal/mol","kcal/mol","BTU/lbmol","eV por partícula"},{1,1000,4.184,4184,2.326,96485.3321233}}; END;
  IF nCat==20 THEN RETURN {{"mol","kmol","mmol","lbmol"},{1,1000,0.001,453.59237}}; END;
  IF nCat==21 THEN RETURN {{"Bq","kBq","MBq","GBq","Ci","mCi","microCi"},{1,1000,1000000,1000000000,37000000000,37000000,37000}}; END;
  IF nCat==22 THEN RETURN {{"Gy","mGy","rad"},{1,0.001,0.01}}; END;
  IF nCat==23 THEN RETURN {{"Sv","mSv","microSv","rem","mrem"},{1,0.001,0.000001,0.01,0.00001}}; END;
  IF nCat==24 THEN RETURN {{"C/kg","roentgen (R)","mR"},{1,0.000258,0.000000258}}; END;
  IF nCat==25 THEN RETURN {{"radián","grado","gradián","vuelta"},{1,0.0174532925199433,0.015707963267949,6.28318530717959}}; END;
  RETURN {{"K","°C","°F","°R"},{1,1,1,1}};
END;

// Temperatura: pasa de la unidad nUni a kelvin.
UnAKelvin(nVal,nUni)
BEGIN
  IF nUni==2 THEN RETURN nVal+273.15; END;
  IF nUni==3 THEN RETURN (nVal+459.67)*5/9; END;
  IF nUni==4 THEN RETURN nVal*5/9; END;
  RETURN nVal;
END;

UnDeKelvin(nVal,nUni)
BEGIN
  IF nUni==2 THEN RETURN nVal-273.15; END;
  IF nUni==3 THEN RETURN nVal*9/5-459.67; END;
  IF nUni==4 THEN RETURN nVal*9/5; END;
  RETURN nVal;
END;

MdUnidades()
BEGIN
  LOCAL nCat,nFin,nFin2,lTab,lNom,lFac,nUni,lDat;
  LOCAL nBase,lLin,nIdx,nVal,lCat,nUlt;
  nFin:=0;
  lCat:=UnCats();
  nUlt:=1;
  REPEAT
    nCat:=UiMenu("Unidades",lCat,{});
    IF nCat==0 THEN
      nFin:=1;
    ELSE
      lTab:=UnDatos(nCat);
      lNom:=lTab(1);
      lFac:=lTab(2);
      nFin2:=0;
      REPEAT
        nUni:=UiMenu(lCat(nCat)+": unidad de origen",lNom,{});
        IF nUni==0 THEN
          nFin2:=1;
        ELSE
          lDat:=UiPedir(lCat(nCat),{"Valor en "+lNom(nUni)+" = "},{"Cantidad a convertir"},{nUlt},0);
          IF SIZE(lDat)>0 THEN
            nUlt:=lDat(1);
            lLin:={"#"+lCat(nCat),"!"+UiNum(nUlt,10)+"  "+lNom(nUni),"#Equivale a"};
            IF nCat==6 THEN
              nBase:=UnAKelvin(nUlt,nUni);
            ELSE
              nBase:=nUlt*lFac(nUni);
            END;
            FOR nIdx FROM 1 TO SIZE(lNom) DO
              IF nIdx<>nUni THEN
                IF nCat==6 THEN
                  nVal:=UnDeKelvin(nBase,nIdx);
                ELSE
                  nVal:=nBase/lFac(nIdx);
                END;
                lLin:=CONCAT(lLin,{" "+UiNum(nVal,9)+"   "+lNom(nIdx)});
              END;
            END;
            UiVer("Unidades",lLin);
          END;
        END;
      UNTIL nFin2;
    END;
  UNTIL nFin;
END;

